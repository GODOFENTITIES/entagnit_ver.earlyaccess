# Public origin. HTTPS is mandatory when NODE_ENV=production.
BETTER_AUTH_URL=https://play.example.com
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
ALLOWED_ORIGINS=https://play.example.com

NODE_ENV=production
HOST=0.0.0.0
PORT=5186
# Enable only behind a proxy that overwrites X-Forwarded-For.
TRUST_PROXY=1

# Production requires PostgreSQL. Add the TLS parameters required by your host.
DATABASE_URL=postgresql://potspark:replace-me@db.example.com:5432/potspark?sslmode=require
PGPOOL_MAX=10

# Email verification and password recovery are unavailable until SMTP is set.
SMTP_URL=smtps://user:replace-me@smtp.example.com:465
AUTH_EMAIL_FROM=Potspark <no-reply@example.com>

# Optional providers. Leave both values for a provider unset to disable it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Veloxwale / Supabase messaging backend
# ---------------------------------------------------------------------------
# Publishable — safe in browser (used by the client-side Supabase SDK).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...

# SERVER-SIDE ONLY — never expose to the browser or commit to version control.
# JWT Secret: Supabase Dashboard → Project Settings → API → JWT Settings.
SUPABASE_JWT_SECRET=your-jwt-secret
# Service-role key: Supabase Dashboard → Project Settings → API → Service Role.
SUPABASE_SERVICE_KEY=sb_secret_...
